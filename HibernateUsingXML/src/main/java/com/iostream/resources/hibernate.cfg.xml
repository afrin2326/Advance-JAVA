<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
	
	<hibernate-configuration>
	<session-factory>
	<property name="driver_class">com.mysql.cj.jdbc.Driver</property>
	<property name="url">jdbc:mysql://localhost:3306/hibernate_db</property>
	<property name="username">root</property>
	<property name="password">SoftwareEng</property>
	
	<property name="hbm2ddl.auto">update</property>
	
	<mapping resources="/com/iostream/resources/Student.hbm.xml"/>
	
	</session-factory>
	
	</hibernate-configuration>